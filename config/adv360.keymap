#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        carrow: carrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "CARROW";
        };

        walrus: walrus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp EQUAL>;
            label = "WALRUS";
        };

        dcolon: dcolon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
            label = "DCOLON";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                   &mo 3      &kp N6  &kp N7  &kp N8    &kp N9     &kp N0    &kp BSLH
&kp TAB         &kp B      &kp L     &kp D     &kp C      &kp V   &none                                                    &none      &kp J   &kp Y   &kp O     &kp U      &kp SEMI  &kp FSLH
&mt LCTRL ESC   &kp N      &kp R     &lt 2 T   &kp S      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp P   &kp H   &lt 2 A   &kp E      &kp I     &mt RCTRL MINUS
&mt LSHFT LPAR  &kp X      &kp Q     &kp M     &kp W      &kp Z                        &kp HOME      &kp PG_UP                        &kp K   &kp F   &kp SQT   &kp COMMA  &kp DOT   &mt RSHFT RPAR
&mo 2           &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN  &kp LBKT   &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none  &none  &none  &none     &none      &none  &trans                                                   &mo 3      &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &none
&none  &none  &none  &none     &none      &none  &none                                                    &none      &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &none
&none  &none  &none  &none     &none      &none  &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &none
&none  &none  &none  &none     &none      &none                       &kp HOME      &kp PG_UP                        &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &none
&mo 2  &none  &none  &kp LEFT  &kp RIGHT         &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0         &kp UP      &kp DOWN      &kp KP_DOT     &none            &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4       &kp F5     &kp F6      &tog 1                                      &mo 3   &kp F7    &kp F8     &kp F9    &kp F10   &kp F11    &kp F12
&none   &kp GRAVE  &kp DQT    &kp PERCENT  &kp CARET  &kp DOLLAR  &none                                       &none   &kp AMPS  &kp LBKT   &kp LBRC  &kp RBRC  &kp RBKT   &kp BSLH
&none   &kp SEMI   &kp MINUS  &kp STAR     &kp PLUS   &kp FSLH    &none   &trans  &trans      &trans  &trans  &none   &kp HASH  &kp EQUAL  &kp LPAR  &kp RPAR  &kp UNDER  &kp COLON
&none   &kp QMARK  &kp AT     &carrow      &walrus    &dcolon                     &trans      &trans                  &kp PIPE  &kp TILDE  &kp LT    &kp GT    &kp EXCL   &none
&none   &none      &none      &none        &none                  &trans  &trans  &trans      &trans  &trans  &trans            &none      &none     &none     &none      &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
